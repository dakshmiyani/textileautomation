# Node Environment
NODE_ENV=development
PORT=8000

# Client Application URL
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL with SQLite local dev fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/textile_erp
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=textile_erp

# Authentication Secrets
JWT_SECRET=textile_erp_ultra_secure_jwt_secret_key_2026_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=textile_erp_ultra_secure_jwt_refresh_secret_key_2026_production
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp Configuration
WHATSAPP_AUTH_DIR=./storage/whatsapp-auth
WHATSAPP_AUTO_CONNECT=false
DUPLICATE_WINDOW_SECONDS=180

# Logging
LOG_LEVEL=info
