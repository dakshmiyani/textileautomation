{
  "name": "textile-erp-server",
  "version": "1.0.0",
  "description": "Textile ERP Backend Server with PostgreSQL, Knex, Baileys WhatsApp integration, and Excel export",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node tests/run_tests.js",
